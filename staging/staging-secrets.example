# HAMZEHI STAGING — secret NAMES only. Never put values in this file or in Git.
# Each value is NEW for staging and is typed interactively:  npx wrangler secret put <NAME> --config staging/wrangler.staging.toml
# NEVER reuse a production value (production ADMIN_TOKEN, production TELEGRAM_BOT_TOKEN, any provider key).
ADMIN_TOKEN=                    # new random value, e.g. 48+ random chars; used only for the staging dashboard/API
TELEGRAM_BOT_TOKEN=             # token of the NEW test bot created with @BotFather (not the production bot)
TELEGRAM_WEBHOOK_SECRET_TOKEN=  # new random value (A-Z a-z 0-9 _ -, 32-256 chars)
# NOT set in staging by default (owner approval required for each): ANTHROPIC_API_KEY, OPENAI_API_KEY, KLING_API_KEY,
# SHOTSTACK_API_KEY, GOOGLE_PLACES_API_KEY, INSTAGRAM_*, WHATSAPP_*.
